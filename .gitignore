# ==============================================================================
# Git Ignore Configuration - AI Revenue Recovery Agent for Razorpay
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (Never Commit Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env

# Keep template examples committed
!.env.example
!*/.env.example

# ------------------------------------------------------------------------------
# 2. Python, Virtual Environments & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

