# ===================================================================
# 🛡️ PAYVIGIL: ENTERPRISE REVENUE RECOVERY ENGINE CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# 🤖 1. AI PROVIDER ORCHESTRATION (Multi-Tier Fallback Cascade)
# -------------------------------------------------------------------
# Tier 1: Google Gemini 2.5 Flash API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 2: Groq Cloud API Key (Get at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Tier 3: Built-in Deterministic Engine (Automatic fallback if no API keys are provided)

# -------------------------------------------------------------------
# 💳 2. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# -------------------------------------------------------------------
# Retrieve these from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -------------------------------------------------------------------
# 🗄️ 3. DATABASE CONFIGURATION
# -------------------------------------------------------------------
# Option A: Supabase PostgreSQL (Recommended Cloud Database)
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option B: Local PostgreSQL / Docker
# Format: postgresql+asyncpg://postgres:postgres@localhost:5432/payvigil_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payvigil_db

# -------------------------------------------------------------------
# 📧 4. OMNI-CHANNEL OUTREACH & ESCALATIONS
# -------------------------------------------------------------------
# Email Recovery via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
SUPPORT_EMAIL=support@yourdomain.com

# Internal Escalation via Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# SMS Recovery via Fast2SMS (India)
FAST2SMS_API_KEY=your_fast2sms_api_key

# WhatsApp & Global SMS Recovery via Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -------------------------------------------------------------------
# 🛡️ 5. SECURITY, GUARDRAILS & DASHBOARD ACCESS
# -------------------------------------------------------------------
# Dashboard Access Key & JWT Signing Secret
DASHBOARD_API_KEY=payvigil-secure-dashboard-api-key-2026
ADMIN_PASSKEY=admin123
SECRET_KEY=payvigil-super-secure-jwt-secret-key-2026

# Financial Guardrails
ENVIRONMENT=development
MAX_RETRY_ATTEMPTS=3
RETRY_COOLDOWN_HOURS=12
