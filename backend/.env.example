# ===================================================================
# 🆓 AI PROVIDER CONFIGURATION (Choose any one or leave empty for Built-in Engine)
# ===================================================================
# Option 1: Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Option 3: Built-in Diagnostic Engine (Automatic fallback if no API key is provided)
# ===================================================================

# Razorpay Credentials (Test Mode / Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Database Configuration
# SQLite (Local Dev): sqlite+aiosqlite:///./revenue_recovery.db
# PostgreSQL (Production / Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/revenue_recovery
DATABASE_URL=sqlite+aiosqlite:///./revenue_recovery.db

# Notifications & Escalation
RESEND_API_KEY=re_your_resend_api_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Dashboard Security & Guardrails
DASHBOARD_API_KEY=your_secure_dashboard_api_key
ENVIRONMENT=development
MAX_RETRY_ATTEMPTS=3
RETRY_COOLDOWN_HOURS=12
