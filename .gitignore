# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (Never Commit Production Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env

# Keep template examples committed
!.env.example
!*/.env.example

