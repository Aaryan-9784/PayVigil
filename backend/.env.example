# ===================================================================
# 🆓 AI PROVIDER CONFIGURATION (Choose any one or leave empty for Built-in Engine)
# ===================================================================
# Option 1: Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Option 3: Built-in Diagnostic Engine (Automatic fallback if no API key is provided)
# ===================================================================

# Razorpay Credentials (Test Mode / Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ===================================================================
# 🗄️ POSTGRESQL / SUPABASE DATABASE CONFIGURATION (PostgreSQL Only)
# ===================================================================
# Option 1: Supabase PostgreSQL (Recommended - 100% Free Cloud Database)
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Or Direct: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option 2: Local PostgreSQL / Docker:
# Format: postgresql+asyncpg://postgres:postgres@localhost:5432/revenue_recovery
DATABASE_URL=postgresql+asyncpg://postgres.your_supabase_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Notifications & Escalation
RESEND_API_KEY=re_your_resend_api_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Dashboard Security & Guardrails
DASHBOARD_API_KEY=your_secure_dashboard_api_key
ENVIRONMENT=development
MAX_RETRY_ATTEMPTS=3
RETRY_COOLDOWN_HOURS=12
